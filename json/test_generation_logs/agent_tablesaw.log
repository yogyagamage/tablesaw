import org.mockito.Mockito;

import java.io.IOException;
import java.io.Writer;
import java.util.ArrayList;
import java.util.List;

public class JsonWriterwrite_ObjectMapperwriteValueAsStringFikaTest {

    @Test
    public void testWrite() throws IOException {
        // Create a simple table with data
        List<Column<?>> columns = new ArrayList<>();
        Column<String> column1 = Column.create("col1", new String[]{"value1", "value2"});
        Column<Integer> column2 = Column.create("col2", new Integer[]{1, 2});
        columns.add(column1);
        columns.add(column2);
        
        Table table = Table.create("test", columns);
        
        // Create JsonWriteOptions with a real destination writer
        Writer mockWriter = Mockito.mock(Writer.class);
        JsonWriteOptions.JsonWriteOptionsBuilder builder = JsonWriteOptions.builder();
        builder.destination(() -> mockWriter);
        builder.header(true);
        builder.asObjects(false);
        JsonWriteOptions options = builder.build();
        
        // Create JsonWriter with a real ObjectMapper
        ObjectMapper mapper = new ObjectMapper();
        JsonWriter writer = new JsonWriter(mapper);
        
        // Execute the entry point method
        writer.write(table, options);
    }
}

