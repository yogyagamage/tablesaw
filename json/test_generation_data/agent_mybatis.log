            if (node.has(columnNames.get(i))) {
                arr[i] = node.get(columnNames.get(i)).asText();
            } else {
                arr[i] = null;
            }
        }
        dataRows.add(arr);
    }
    return TableBuildingUtils.build(columnNames, dataRows, options);
}
